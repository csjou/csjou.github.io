<Window x:Class="wk0105b.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:wk0105b"
        mc:Ignorable="d"
        Title="WPF 圖書系統" Height="350" Width="500">
    <Grid>
        <DataGrid x:Name="BookDataGrid" AutoGenerateColumns="True" 
                  Margin="10,10,10,100"/>
        <Button x:Name="BorrowButton" Content="借書" 
                Click="BorrowButton_Click" 
                Margin="10,250,10,10" Height="40"/>
    </Grid>

</Window>
